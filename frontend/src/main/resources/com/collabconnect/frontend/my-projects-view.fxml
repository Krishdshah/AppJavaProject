<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="200.0" prefWidth="100.0" spacing="20.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Label text="My Projects">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>
        <VBox style="-fx-background-color: #FFFFFF; -fx-background-radius: 5; -fx-padding: 10;">
            <children>
                <Label text="Project Alpha - Collaboration Partner Finder" />
                <Label text="Status: In Progress" />
            </children>
        </VBox>
        <VBox style="-fx-background-color: #FFFFFF; -fx-background-radius: 5; -fx-padding: 10;">
            <children>
                <Label text="Project Beta - University Research Tool" />
                <Label text="Status: Completed" />
            </children>
        </VBox>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>