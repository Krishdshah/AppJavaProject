<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="540.0" prefWidth="600.0" spacing="20.0" styleClass="content-area" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.collabconnect.MyProjectsController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>
    <children>
        <HBox alignment="CENTER_LEFT">
            <Label styleClass="title-2" text="My Projects" textFill="WHITE" />
            <Region HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#handleCreateProject" styleClass="accent, scale-on-hover" text="+ Create Project" />
        </HBox>
        
        <TabPane VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE">
            <tabs>
                <Tab text="Active">
                    <content>
                        <VBox fx:id="activeProjectsBox" spacing="15.0">
                            <padding>
                                <Insets top="20.0" />
                            </padding>
                        </VBox>
                    </content>
                </Tab>
                <Tab text="Completed">
                    <content>
                        <VBox fx:id="completedProjectsBox" spacing="15.0">
                            <padding>
                                <Insets top="20.0" />
                            </padding>
                        </VBox>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </children>
</VBox>