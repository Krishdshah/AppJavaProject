<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="600.0" prefWidth="800.0" styleClass="app-background" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.collabconnect.LoginController">
    <children>
        <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" prefWidth="380.0" spacing="20.0" styleClass="glass-card">
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
            </padding>
            <children>
                <Label styleClass="title-2" text="CollabConnect" />
                <Label styleClass="text-muted" text="Sign in to continue" />
                
                <VBox spacing="5.0">
                    <Label text="User ID" styleClass="text-small" />
                    <TextField fx:id="userIdField" promptText="Enter your User ID" />
                </VBox>
                
                <VBox spacing="5.0">
                    <Label text="Password" styleClass="text-small" />
                    <PasswordField fx:id="passwordField" promptText="Enter your password" />
                </VBox>
                
                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleLoginButtonAction" styleClass="accent, scale-on-hover" text="Sign In" />
                
                <Label fx:id="statusLabel" wrapText="true" />
                
                <Hyperlink onAction="#switchToRegistration" text="Don't have an account? Register" />
            </children>
        </VBox>
    </children>
</StackPane>