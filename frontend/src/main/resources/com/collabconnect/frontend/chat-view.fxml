<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>

<HBox prefHeight="540.0" prefWidth="600.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.collabconnect.ChatController">
    <!-- Sidebar for Contacts -->
    <VBox prefWidth="200.0" style="-fx-background-color: #0d1117; -fx-border-color: transparent rgba(240, 246, 252, 0.1) transparent transparent; -fx-border-width: 1px;">
        <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
        </padding>
        <children>
            <Label styleClass="title-3" text="Messages" textFill="WHITE">
                <VBox.margin><Insets bottom="15.0" /></VBox.margin>
            </Label>
            <TextField promptText="Search messages..." styleClass="rounded" />
            <VBox fx:id="contactsList" spacing="5.0" VBox.vgrow="ALWAYS">
                <VBox.margin><Insets top="15.0" /></VBox.margin>
            </VBox>
        </children>
    </VBox>

    <!-- Main Chat Area -->
    <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: #161b22;">
        <children>
            <!-- Chat Header -->
            <HBox alignment="CENTER_LEFT" prefHeight="60.0" style="-fx-border-color: transparent transparent rgba(240, 246, 252, 0.1) transparent; -fx-border-width: 1px;">
                <padding>
                    <Insets left="20.0" right="20.0" />
                </padding>
                <children>
                    <Label fx:id="chatHeaderName" styleClass="title-3" text="Laksh Baweja" textFill="WHITE" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label styleClass="text-muted" text="Online" textFill="#3fb950" />
                </children>
            </HBox>
            
            <!-- Chat History -->
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background: transparent; -fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                <content>
                    <VBox fx:id="messageHistory" spacing="15.0">
                        <padding>
                            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                        </padding>
                    </VBox>
                </content>
            </ScrollPane>
            
            <!-- Message Input -->
            <HBox alignment="CENTER" prefHeight="70.0" spacing="10.0" style="-fx-border-color: rgba(240, 246, 252, 0.1) transparent transparent transparent; -fx-border-width: 1px;">
                <padding>
                    <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                </padding>
                <children>
                    <TextField fx:id="messageInput" onAction="#handleSendMessage" promptText="Type a message..." HBox.hgrow="ALWAYS" />
                    <Button mnemonicParsing="false" onAction="#handleSendMessage" styleClass="accent" text="Send" />
                </children>
            </HBox>
        </children>
    </VBox>
</HBox>
